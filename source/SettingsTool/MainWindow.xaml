<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="AC8 · MOD 1.0" Width="1100" Height="820" MinWidth="980" MinHeight="720" WindowStartupLocation="CenterScreen"
 Background="#101A22" Foreground="#F1EEE6" FontFamily="Microsoft YaHei UI" FontSize="14" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#A8B8C2"/>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#1B2B36"/><Setter Property="Foreground" Value="#F1EEE6"/><Setter Property="BorderBrush" Value="#647C8C"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="18,10"/><Setter Property="MinHeight" Value="40"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#304451"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".8"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#F8B700"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".42"/></Trigger>
     <MultiTrigger><MultiTrigger.Conditions><Condition Property="Tag" Value="primary"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions><Setter TargetName="Surface" Property="Background" Value="#FFC522"/></MultiTrigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><Trigger Property="Tag" Value="primary"><Setter Property="Background" Value="#F8B700"/><Setter Property="Foreground" Value="#101A22"/><Setter Property="BorderBrush" Value="#F8B700"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="0,2"/><Setter Property="MinHeight" Value="36"/>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="#0C151C"/><Setter Property="Foreground" Value="#F1EEE6"/><Setter Property="CaretBrush" Value="#F8B700"/>
   <Setter Property="BorderBrush" Value="#647C8C"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,9"/><Setter Property="MinHeight" Value="38"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="SelectionBrush" Value="#466372"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
    <Border x:Name="Edge" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
     <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Edge" Property="BorderBrush" Value="#F8B700"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#F1EEE6"/><Setter Property="Background" Value="#172731"/><Setter Property="Padding" Value="12,10"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#314957"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#3C3927"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="#F1EEE6"/><Setter Property="Background" Value="#0C151C"/><Setter Property="BorderBrush" Value="#647C8C"/><Setter Property="MinHeight" Value="40"/><Setter Property="Padding" Value="12,8"/>
   <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
    <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}">
     <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="SelectEdge" Background="#0C151C" BorderBrush="{Binding BorderBrush,RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="1" CornerRadius="6">
      <Path Data="M 0,0 L 5,5 L 10,0" Stroke="#A8B8C2" StrokeThickness="1.5" Width="10" Height="5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0"/>
     </Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SelectEdge" Property="BorderBrush" Value="#F8B700"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
    </ToggleButton>
    <ContentPresenter Margin="12,8,32,8" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
    <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"><Border Background="#172731" BorderBrush="#647C8C" BorderThickness="1" CornerRadius="6" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="300"><ItemsPresenter/></ScrollViewer></Border></Popup>
   </Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#F8B700"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="Foreground" Value="#F1EEE6"/><Setter Property="MinHeight" Value="38"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border x:Name="Track" Width="40" Height="22" CornerRadius="11" Background="#324955" BorderBrush="#8097A5" BorderThickness="1" VerticalAlignment="Center">
     <Ellipse x:Name="Knob" Width="14" Height="14" Fill="#F1EEE6" HorizontalAlignment="Left" Margin="3,0,0,0"/>
    </Border><ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"/>
   </Grid><ControlTemplate.Triggers>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#F8B700"/><Setter TargetName="Track" Property="BorderBrush" Value="#F8B700"/><Setter TargetName="Knob" Property="Fill" Value="#101A22"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="#F1EEE6"/><Setter TargetName="Track" Property="BorderThickness" Value="2"/></Trigger>
   </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Slider">
   <Setter Property="Foreground" Value="#F8B700"/><Setter Property="MinHeight" Value="30"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid VerticalAlignment="Center">
    <Border Height="3" Background="#536B7A" CornerRadius="2"/>
    <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
     <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="3" Background="#F8B700" CornerRadius="2"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
     <Track.Thumb><Thumb Width="16" Height="22"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="Handle" Background="#F1EEE6" CornerRadius="4" BorderBrush="#0C151C" BorderThickness="1"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Handle" Property="Background" Value="#F8B700"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
    </Track>
   </Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="#F8B700"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="10"/><Setter Property="Background" Value="#15232D"/><Setter Property="Focusable" Value="False"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
    <Grid Background="{TemplateBinding Background}">
     <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}" IsDirectionReversed="True">
      <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
      <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="ScrollHandle" Background="#607D8E" CornerRadius="4" Margin="2"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ScrollHandle" Property="Background" Value="#A8B8C2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
      <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
     </Track>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid Background="#101A22">
  <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#15232D" BorderBrush="#344550" BorderThickness="0,0,1,0">
   <Grid Margin="20,28,20,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock x:Name="Brand" Text="AC8" FontSize="34" FontWeight="SemiBold"/><TextBlock Text="一体化 MOD 工具" Foreground="#A8B8C2" FontSize="13" Margin="0,4,0,14"/></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Navigation"/></ScrollViewer>
    <StackPanel Grid.Row="2"><TextBlock Text="当前 MOD 文件夹" FontSize="11" Foreground="#A8B8C2"/><TextBlock x:Name="PackageName" Text="正在读取…" TextWrapping="Wrap" FontSize="12" Margin="0,7,0,12"/>
     <Button x:Name="ChoosePackage" Content="切换文件夹" Padding="10,8" FontSize="12"/>
     <Button x:Name="Reload" Content="重新读取配置" Padding="10,8" FontSize="12" Margin="0,8,0,0"/>
     <TextBlock x:Name="VersionText" Text="设置工具 1.0" Foreground="#A8B8C2" FontSize="11" Margin="0,18,0,0"/>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Margin="32,29,32,20"><TextBlock x:Name="PageTitle" Text="鼠标与飞控" FontSize="27" FontWeight="SemiBold"/>
    <TextBlock x:Name="PageDescription" Text="调整操纵手感，保存后在下次启动时生效。" Foreground="#A8B8C2" TextWrapping="Wrap" FontSize="13" Margin="0,8,0,0"/>
   </StackPanel>
   <ScrollViewer x:Name="ContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,0,32,24">
    <StackPanel x:Name="PageBody"/>
   </ScrollViewer>
   <Border Grid.Row="2" BorderBrush="#344550" BorderThickness="0,1,0,0" Background="#101A22" Padding="28,17">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock x:Name="Status" Text="读取配置中…" Foreground="#A8B8C2" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>
     <StackPanel x:Name="SettingTools" Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
      <Button x:Name="PageDefaults" Content="本页默认" Padding="12,6" MinHeight="32" FontSize="12"/>
      <Button x:Name="RestoreBackup" Content="恢复最近备份" Margin="10,0,0,0" Padding="12,6" MinHeight="32" FontSize="12"/>
      <TextBlock x:Name="FooterHint" Text="下次启动生效" Foreground="#A8B8C2" VerticalAlignment="Center" FontSize="12" Margin="16,0,0,0"/>
     </StackPanel>
     <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button x:Name="Save" Content="保存设置" MinWidth="110" Padding="16,10"/>
      <CheckBox x:Name="SteamLaunch" Grid.Column="1" Content="从 Steam 启动" IsChecked="True" Margin="18,0,12,0" VerticalAlignment="Center" ToolTip="关闭后直接运行 MOD 会话启动流程，需要 Steam 已运行。"/>
      <Button x:Name="StartGame" Grid.Column="3" Content="开始游戏" Tag="primary" MinWidth="158" FontSize="15" Padding="24,12"/>
     </Grid>
     <ProgressBar x:Name="Busy" Grid.Row="3" IsIndeterminate="True" Visibility="Collapsed" Height="4" Foreground="#F8B700" Background="#344550" Margin="0,12,0,0"/>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</Window>
